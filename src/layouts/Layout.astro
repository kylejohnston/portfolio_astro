---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;

const description = "Kyle Johnston is a product designer with deep experience in UI/UX design, visual design, and branding";
const ogImage = new URL('/og-image.png', Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kyle Johnston" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-untitled" preload />
    <Font cssVariable="--at-textual" preload />
  </head>
  <body class="bg-paper my-12">
    <Nav />
    <main class="max-w-[var(--grid-max-width)] mx-auto px-[var(--grid-margin)] pt-24 grid grid-cols-12 gap-[var(--grid-gutter)]">
      <slot />
    </main>

    <script is:inline>
      // Runs synchronously (is:inline, no defer) right after `.reveal`
      // elements exist in the DOM and before first paint, so there's no
      // flash between the default scroll-linked state and this
      // reclassification. Elements already in view get `.reveal-onload` +
      // a staggered delay for a real page-load entrance (see the `.reveal`
      // rules in global.css); elements below the fold are left on the
      // default scroll-driven reveal.
      //
      // Exposed as window.__classifyReveal so overlay.js can re-run it
      // against freshly injected content — a project's case-study images
      // load via `innerHTML` when opened in the overlay, which never
      // re-triggers a page-load script on its own, so without this the
      // overlay would leave every image on the scroll-linked path even
      // ones visible the instant the overlay opens.
      //
      // Also sets --reveal-onload-total, the moment the last onload
      // element finishes its own fade-up (600ms) — SetView.astro's
      // signature draw-on reads this to start only once the work cards
      // above the fold are done animating in, instead of a guessed delay.
      window.__classifyReveal = function (root, viewportBottom) {
        var els = (root || document).querySelectorAll('.reveal:not(.reveal-onload)');
        var bottom = viewportBottom == null ? window.innerHeight : viewportBottom;
        var delay = 0;
        for (var i = 0; i < els.length; i++) {
          if (els[i].getBoundingClientRect().top < bottom) {
            els[i].style.setProperty('--reveal-delay', delay + 'ms');
            els[i].classList.add('reveal-onload');
            delay += 80;
          }
        }
        if (delay > 0) {
          document.documentElement.style.setProperty('--reveal-onload-total', (delay - 80 + 600) + 'ms');
        }
      };
      window.__classifyReveal();
    </script>

    <div class="overlay-background" id="overlayBackground" aria-hidden="true"></div>
    <div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="overlay-panel halftone-fill" aria-hidden="true"></div>
      <button id="closeOverlay" aria-label="Close overlay">
        <span aria-hidden="true">×</span>
      </button>
      <div class="overlay-content grid grid-cols-10 gap-6 px-[var(--overlay-content-pad)] pt-3 lg:pt-9">
        <div id="overlayPageContent" class="col-start-1 col-span-10"></div>
      </div>
    </div>

    <script src="../scripts/overlay.js"></script>
    <script src="../scripts/outcome-reel.js"></script>
    {import.meta.env.DEV && <script src="../scripts/grid-jig.js"></script>}
  </body>
</html>
