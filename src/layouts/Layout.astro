---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;

// On a curated homepage, keep the logo/Work link pointing back to it instead
// of the root homepage — this is what the underlying page renders while the
// overlay is open, so it also fixes nav during in-app browsing from /for/*.
const homeHref = Astro.url.pathname.startsWith('/for/') ? Astro.url.pathname : '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-host" preload />
    <Font cssVariable="--at-textual" preload />
  </head>
  <body class="bg-paper my-12">
    <header class="site-header border max-w-[var(--grid-max-width)] mx-auto px-[var(--grid-margin)] grid grid-cols-12 gap-[var(--grid-gutter)]">
      <div class="col-span-5 col-start-2">
        <div><a class="site-title" href={homeHref}>Kyle Johnston</a></div>
        <div>Product Designer</div>
      </div>
      <nav class="col-span-6 flex gap-6">
        <div>
          <a href={homeHref} class="flex gap-1 items-center">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.75 7.96875C18.75 13.4375 10.6414 17.8641 10.2961 18.0469C10.2051 18.0958 10.1033 18.1215 10 18.1215C9.89665 18.1215 9.79492 18.0958 9.70391 18.0469C9.35859 17.8641 1.25 13.4375 1.25 7.96875C1.25145 6.68455 1.76223 5.45337 2.6703 4.5453C3.57837 3.63723 4.80955 3.12645 6.09375 3.125C7.70703 3.125 9.11953 3.81875 10 4.99141C10.8805 3.81875 12.293 3.125 13.9062 3.125C15.1904 3.12645 16.4216 3.63723 17.3297 4.5453C18.2378 5.45337 18.7486 6.68455 18.75 7.96875Z" fill="#FF8888"/>
            </svg>
            Work
          </a>
        </div>
        <div>
          <a href="/about" class="flex gap-1 items-center">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15.4203 6.92316C15.8382 7.62639 16.1124 8.40548 16.2272 9.21537C16.342 10.0253 16.295 10.8499 16.0891 11.6415C15.8831 12.4331 15.5222 13.1761 15.0273 13.8274C14.5324 14.4786 13.9133 15.0253 13.2057 15.4358C12.4982 15.8462 11.7163 16.1123 10.9052 16.2186C10.0942 16.325 9.27008 16.2694 8.48064 16.0552C7.6912 15.841 6.95206 15.4724 6.30599 14.9707C5.65991 14.4691 5.11973 13.8442 4.71667 13.1325L1.83878 8.148C1.70189 7.89062 1.67025 7.59014 1.75054 7.30989C1.83083 7.02964 2.01677 6.7915 2.26919 6.64564C2.5216 6.49979 2.82078 6.45762 3.10368 6.52801C3.38658 6.5984 3.63111 6.77586 3.78574 7.023L5.09074 9.28144C5.12767 9.34543 5.17685 9.40151 5.23546 9.4465C5.29407 9.49148 5.36096 9.52448 5.43233 9.54361C5.50369 9.56274 5.57812 9.56763 5.65137 9.55799C5.72463 9.54836 5.79526 9.52439 5.85925 9.48745C5.92324 9.45052 5.97933 9.40134 6.02431 9.34273C6.06929 9.28412 6.10229 9.21723 6.12142 9.14586C6.14055 9.0745 6.14544 9.00007 6.13581 8.92682C6.12617 8.85356 6.1022 8.78293 6.06527 8.71894L3.3048 3.93769C3.1679 3.6803 3.13627 3.37983 3.21656 3.09958C3.29684 2.81933 3.48278 2.58119 3.7352 2.43533C3.98762 2.28948 4.2868 2.24731 4.56969 2.3177C4.85259 2.38809 5.09712 2.56555 5.25175 2.81269L8.01574 7.59394C8.05158 7.65995 8.10028 7.71811 8.15897 7.765C8.21766 7.81188 8.28514 7.84653 8.35744 7.86691C8.42974 7.88729 8.50538 7.89299 8.57992 7.88366C8.65445 7.87433 8.72636 7.85017 8.79141 7.8126C8.85645 7.77503 8.91331 7.72481 8.95863 7.66491C9.00395 7.60501 9.03682 7.53663 9.05529 7.46382C9.07376 7.39102 9.07746 7.31524 9.06617 7.24098C9.05488 7.16672 9.02883 7.09547 8.98956 7.03144L6.88019 3.37519C6.73537 3.11708 6.6981 2.81229 6.77645 2.52689C6.8548 2.24148 7.04246 1.99845 7.29877 1.85046C7.55507 1.70246 7.85937 1.66143 8.14572 1.73626C8.43207 1.81108 8.6774 1.99573 8.82855 2.25019L11.672 7.1805C11.0432 7.81414 10.6896 8.67005 10.6876 9.56269C10.6855 10.2933 10.9226 11.0045 11.3626 11.5877C11.4065 11.648 11.4619 11.6991 11.5257 11.7378C11.5895 11.7765 11.660