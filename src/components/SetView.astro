---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import type { Set } from '../data/sets';

interface Props {
  set: Set;
  heading: string;
}

const { set, heading } = Astro.props;
const all = await getCollection('projects');

const picked = set.projects.map(({ id, why }) => {
  const entry = all.find((e) => e.id === id);
  if (!entry) throw new Error(`Unknown project id "${id}"`);
  return { entry, why };
});

// Flip to compare hero treatments. Build-time only — edit, save, Vite HMR
// updates the page instantly, so this doesn't need to be a runtime toggle.
const HERO_V2 = true;
---

{HERO_V2 ? (
  <div class="hero-v2-wrap">
    <div class="hero-panel hero-panel-a halftone-fill" aria-hidden="true"></div>
    <div class="hero-v2-intro col-start-3 col-span-7 px-12 py-16 text-ink">
      <h1>{heading}</h1>
      <p>{set.intro}</p>
    </div>
    <div class="hero-panel hero-panel-b" aria-hidden="true"></div>
  </div>
) : (
  <div id="hi" class="col-span-5 col-start-7 text-white">
    <div class="hero py-24 halftone-backdrop">
      <h1 class="">{heading}</h1>
      <p class="">{set.intro}</p>
    </div>
  </div>
)}
<div id="work" class="col-span-12">
  <div class="card-grid grid grid-cols-12 gap-x-6 gap-y-24">
    {picked.map(({ entry, why }) => <ProjectCard entry={entry} why={why} />)}
    <div class="col-span-10 col-start-2 mb-24">
      <p class="see-all"><a href="/work">See all work</a></p>
    </div>
  </div>
</div>

<style>
  .hero {
    color: var(--white);
  }
  .intro {
    max-width: 60ch;
    font-size: 1.125rem;
  }
  #work {
    /* margin-top: -80px; */
    /* padding-top: 80px; */
    position: relative;
    z-index: 1;
    /* background-color: var(--color-paper); */
    /* clip-path: polygon(0 80px, 100% 0, 100% 100%, 0 100%); */
  }
  #work::before {
    /* content: "";
    position: absolute;
    z-index: -1;
    inset: 1; */
    /* margin-top: -80px; */
    /* padding-top: 80px; */
    /* background-color: var(--color-paper); */
    /* clip-path: polygon(0 80px, 100% 0, 100% 100%, 0 100%); */
  }
  .see-all {
  }

  /* ============================================================
     Hero v2 — two decorative panels bleeding past the grid, with
     the hero copy layered on top in normal flow. Both panels are
     purely visual: position:absolute + negative z-index keeps them
     behind the (non-positioned) intro text without any extra
     stacking-context bookkeeping there.

     Desktop: .hero-v2-wrap deliberately has no `position` set, so
     the panels (position:absolute with no positioned ancestor
     anywhere up to <html>) resolve against the true document root
     instead of the wrapper's own box — that's what lets them start
     at the actual top of the page and paint behind <header> and
     <main> without living outside them in the DOM. Negative z-index
     still means "behind everything non-positioned," now evaluated
     against the whole page's stacking context rather than just this
     component's box.

     --main-inset is "how far the grid's column 1 sits from the
     actual viewport edge" — the same math .overlay uses to align
     itself to <main>'s columns, but that version lives inside
     .overlay's own rule (not :root), so it isn't reachable here;
     recomputed locally from the shared --grid-* :root tokens instead.
     ============================================================ */
  .hero-v2-wrap {
    grid-column: span 12;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--grid-gutter);
    --container-width: min(100vw, var(--grid-max-width));
    --container-offset: calc((100vw - var(--container-width)) / 2);
    --hero-grid-col: calc((var(--container-width) - 2 * var(--grid-margin) - 11 * var(--grid-gutter)) / 12);
    --main-inset: calc(var(--container-offset) + var(--grid-margin));
  }
  .hero-panel {
    position: absolute;
  }
  .hero-panel-a {
    /* Literal top-left of the page — bleeds past the header on the
       left and sits behind it vertically. Right edge still lands
       exactly on the column 11/12 boundary, same as the rest of the
       grid. */
    top: 0;
    left: 0;
    width: calc(var(--main-inset) + 10 * var(--hero-grid-col) + 9 * var(--grid-gutter));
    aspect-ratio: 16 / 7;
    --dot-color: #FFCDCD; /* .dot-color-a */
    --bg-color: var(--color-paper);
    z-index: -2;
  }
  .hero-panel-b {
    /* Left edge grid-aligned to the start of column 3; right edge
       bleeds to the viewport edge. 48px down from the top of the
       page — shorter than the header, so it overlaps it. */
    top: 48px;
    left: calc(var(--main-inset) + 2 * (var(--hero-grid-col) + var(--grid-gutter)));
    right: 0;
    aspect-ratio: 16 / 9;
    background-color: var(--color-accent);
    mix-blend-mode: multiply;
    z-index: -1;
  }

  @media (max-width: 640px) {
    .hero-v2-wrap {
      /* Mobile panels are scoped to this wrapper's own box (see the
         padding-bottom trick below), not the document root, so this
         needs to be a positioning context again here. */
      position: relative;
      display: block;
      padding-bottom: 64px; /* background peeks out below the foreground block by this much */
    }
    .hero-v2-intro {
      padding-block: 32px 24px;
    }
    .hero-panel-a {
      /* Background block: fills the whole wrap vertically (including
         the 64px padding-bottom above, so it always extends exactly
         that far past the foreground block below regardless of copy
         length), but still bleeds past the wrap's own inset horizontally
         to reach the true viewport edges. */
      top: 0;
      bottom: 0;
      left: calc(-1 * var(--main-inset));
      right: calc(-1 * var(--main-inset));
      width: auto;
      aspect-ratio: auto;
    }
    .hero-panel-b {
      /* Foreground block: back in normal flow, after the intro copy —
         static position paints above the negative-z-index background
         with no extra z-index bookkeeping needed. */
      position: static;
      top: auto;
      width: calc(100% - 2 * var(--grid-margin));
      margin-inline: auto;
      aspect-ratio: 1 / 1;
    }
  }
</style>
