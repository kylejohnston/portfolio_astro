---
interface Props {
  value1: string;
  label1: string;
  value2: string;
  label2: string;
}

const { value1, label1, value2, label2 } = Astro.props;
---

<div class="outcome col-start-3 col-span-6 grid grid-cols-2 gap-6">
  <div>
    <div class="outcome__value">{value1}</div>
    <div class="outcome__label">{label1}</div>
  </div>
  <div>
    <div class="outcome__value">{value2}</div>
    <div class="outcome__label">{label2}</div>
  </div>
</div>

<!-- .outcome/.outcome__value/.outcome__label styles live in global.css, not
     here — a scoped <style> block would only ship on pages that import this
     component directly, and the overlay never loads the underlying page's
     <head>, so the case study's own styles would silently go missing there. -->
