---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  desktop: { src: ImageMetadata; alt: string };
  mobile: { src: ImageMetadata; alt: string };
  rounded?: boolean;
  shadow?: boolean;
  border?: boolean;
}

const { desktop, mobile, rounded = false, shadow = false, border = false } = Astro.props;
const imgClass = [
  'w-full h-auto',
  rounded && 'rounded',
  shadow && 'shadow-[0_0_16px_0_rgba(35,26,26,0.08)]',
  border && 'border border-[var(--color-border)]',
];
---

<div class="scroller col-span-12 grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-x-6 my-3">
  <div class="sm:col-span-7 sm:col-start-2 scroll-desktop">
    <div class="h-6 bg-muted-brand"></div>
    <Image src={desktop.src} alt={desktop.alt} quality="max" densities={[1, 2]} class:list={imgClass} />
  </div>
  <div class="sm:col-span-3 scroll-mobile">
    <div class="h-6 bg-muted-brand"></div>
    <Image src={mobile.src} alt={mobile.alt} quality="max" densities={[1, 2]} class:list={imgClass} />
  </div>
</div>