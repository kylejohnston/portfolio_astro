---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  left: { src: ImageMetadata; alt: string };
  right: { src: ImageMetadata; alt: string };
  rounded?: boolean;
  shadow?: boolean;
  border?: boolean;
}

const { left, right, rounded = false, shadow = false, border = false } = Astro.props;
const imgClass = [
  'w-full h-auto my-3',
  rounded && 'rounded',
  shadow && 'shadow-[0_0_16px_0_rgba(35,26,26,0.08)]',
  border && 'border border-[var(--color-border)]',
];
---

<div class="side-by-side col-span-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
  <Image src={left.src} alt={left.alt} quality="max" densities={[1, 2]} class:list={imgClass} />
  <Image src={right.src} alt={right.alt} quality="max" densities={[1, 2]} class:list={imgClass} />
</div>
