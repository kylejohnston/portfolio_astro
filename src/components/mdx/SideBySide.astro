---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  left: { src: ImageMetadata; alt: string };
  right: { src: ImageMetadata; alt: string };
}

const { left, right } = Astro.props;
---

<div class="side-by-side col-span-12 grid grid-cols-2 gap-6">
  <Image src={left.src} alt={left.alt} class="w-full h-auto" />
  <Image src={right.src} alt={right.alt} class="w-full h-auto" />
</div>
