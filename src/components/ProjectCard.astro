---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  why?: string;
}

const { entry, why } = Astro.props;
---

<a class="project-card col-start-2 col-span-10 items-center gap-6" href={`/work/${entry.id}`}>
  <Image class="project-card__cover" src={entry.data.cover} alt={entry.data.coverAlt} width={549} height={309} />
  <div class="project-card__body">
    <h2 class="project-card__title">{entry.data.title}</h2>
    <p class="project-card__summary">{entry.data.summary}</p>
    {why && <p class="project-card__why">{why}</p>}
  </div>
</a>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    color: inherit;
    text-decoration: none;
  }
  .project-card__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9
    object-fit: cover;
    grid-column: 1;
    border-radius: 4px;
    --webkit-box-shadow: 0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -1px rgba(0,0,0,.06);
    box-shadow: 0 4px 6px -1px #0000001a,0 2px 4px -1px #0000000f;
    transition: all .25s ease;
  }
    .project-card__cover:hover {
      --webkit-box-shadow: 0 20px 25px -5px rgba(0,0,0,.1),0 10px 10px -5px rgba(0,0,0,.04);
      box-shadow: 0 20px 25px -5px #0000001a,0 10px 10px -5px #0000000a;
    }
  .project-card__title {
    font-size: var(--text-lg);
    line-height: var(--text-lg--lh);
    text-wrap: balance;
  }
  .project-card__summary {
    text-wrap: balance;
  }
  .project-card__body {
    grid-column: 2;
    padding-left:  24px;
    padding-right: 48px;
  }
  /* Alternate which side the image/text sit on for every other card.
     nth-of-type (not nth-child) so inserting non-.project-card content
     between cards later won't throw off the counting. */
  .project-card:nth-of-type(even) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .project-card:nth-of-type(even) .project-card__cover {
    grid-column: 2;
    grid-row: 1;
  }
  .project-card:nth-of-type(even) .project-card__body {
    grid-column: 1;
    grid-row: 1;
    padding-left:  48px;
    padding-right: 24px;
  }
</style>
