---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  why?: string;
}

const { entry, why } = Astro.props;
---

<a class="project-card reveal" href={`/work/${entry.id}`}>
  <Image class="project-card__cover" src={entry.data.cover} alt={entry.data.coverAlt} quality="max" densities={[1, 2]} width={549} height={309} />
  <div class="project-card__body">
    <h2 class="project-card__title">Client: {entry.data.client}</h2>
    <p class="project-card__summary"><strong>Project:</strong> {entry.data.summary}</p>
    {why && <p class="project-card__why">{why}</p>}
  </div>
</a>

<style>
  .project-card {
    display: block;
    border-radius: 20px;
    padding: 8px;
    background: hsla(0, 24%, 100%, 1);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: inherit;
    text-decoration: none;
    box-shadow:
    0px 0px 0px 1px rgba(35, 26, 26, 0.06),
    0px 1px 2px -1px rgba(35, 26, 26, 0.06),
    0px 2px 4px 0px rgba(35, 26, 26, 0.04);
    transition: box-shadow .25s ease;
  }
  .project-card:hover {
      box-shadow: 0 20px 25px -5px #0000001a,0 10px 10px -5px #0000000a;
  }
  .project-card__cover {
    display: block;
    width: 100%;
    height: auto; 
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 8px;
    box-shadow:
    0px 0px 0px 1px rgba(35, 26, 26, 0.02),
    0px 1px 2px -1px rgba(35, 26, 26, 0.02),
    0px 2px 4px 0px rgba(35, 26, 26, 0.04);
  }
  .project-card__body {
    padding: 6px 12px;
  }
  .project-card__title {
    font-size: var(--text-base);
    line-height: var(--text-base--lh);
    text-wrap: balance;
    margin-block: 0;
  }
  .project-card__summary,
  .project-card__why
  {
    text-wrap: balance;
    margin-block: 4px;
  }
@media (min-width: 640px) {
  .project-card__body {
    padding: 8px 16px;
  }
  .project-card__summary,
  .project-card__why
  {
    text-wrap: balance;
    margin-block: 8px;
  }
}
</style>
