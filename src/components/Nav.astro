    </svg>
    <span class="nav-pill__label">About</span>
  </a>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    /* Above ordinary page content, but still below .overlay-background
       (998) / .overlay (999) — the overlay is a modal takeover and should
       cover the nav the same way it already covers everything else. */
    z-index: 10;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 12px;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 0 16px 0 rgba(35, 26, 26, 0.08);
    color: var(--color-ink);
    text-decoration: none;
    transition: padding 0.2s ease;
  }

  .nav-pill__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: block;
    fill: var(--color-ink);
  }

  /* Whichever pill matches the current page gets the accent-colored icon;
     every other pill's icon stays ink. */
  .nav-pill.is-active .nav-pill__icon {
    fill: var(--color-accent);
  }

  .nav-pill__label {
    display: inline-block;
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    font-family: var(--at-textual);
    font-size: 17px;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
    transition: max-width 0.25s ease, margin-left 0.25s ease, opacity 0.15s ease;
  }

  .nav-pill.is-active,
  .nav-pill:hover {
    padding: 10px 14px 10px 12px;
  }

  .nav-pill.is-active .nav-pill__label,
  .nav-pill:hover .nav-pill__label {
    max-width: 120px;
    margin-left: 4px;
    opacity: 1;
  }
</style>
