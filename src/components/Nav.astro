<style>
  .site-nav {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    /* Above ordinary page content, but still below .overlay-background
       (998) / .overlay (999) — the overlay is a modal takeover and should
       cover the nav the same way it already covers everything else. */
    z-index: 10;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 12px;
    background: #fff;
    border-radius: 12px;
    border: 1px solid #E6E3E37F;
    /* box-shadow: 0 0 16px 0 rgba(35, 26, 26, 0.08); */
    color: var(--color-ink);
    text-decoration: none;
    transition: padding 220ms ease;
    font-family: var(--font-style);
    font-variant-numeric: normal;
  }

  .nav-pill__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: block;
    fill: var(--color-ink);
    transition: fill 220ms ease;
  }

  /* Whichever pill matches the current page gets the accent-colored icon;
     every other pill's icon stays ink. Hovering any pill previews the
     same accent color regardless of active state. */
  .nav-pill.is-active .nav-pill__icon,
  .nav-pill:hover .nav-pill__icon {
    fill: var(--color-accent);
  }

  .nav-pill__label {
    display: inline-block;
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    font-family: var(--at-textual);
    font-size: var(--text-sm);
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
    transition: max-width 220ms ease, margin-left 220ms ease, opacity 220ms ease;
  }

  .nav-pill.is-active,
  .nav-pill:hover {
    padding: 10px 14px 10px 12px;
  }

  .nav-pill.is-active .nav-pill__label,
  .nav-pill:hover .nav-pill__label {
    max-width: 120px;
    margin-left: 4px;
    opacity: 1;
  }
  .wave {
    animation: wave-animation 3s linear 2;
    transform-origin: 57% 86%;
  }
  
  @keyframes wave-animation {
    0% { transform:   rotate(00.0deg) }
    14% { transform:  rotate(00.0deg) }
    20% { transform:  rotate(-16.0deg) }
    30% { transform:  rotate(14.0deg) }
    40% { transform:  rotate(-8.0deg) }
    50% { transform:  rotate(12.0deg) }
    60% { transform:  rotate(-8.0deg) }
    70% { transform:  rotate(00.0deg) }
    100% { transform: rotate(00.0deg) }
  }
</style>
