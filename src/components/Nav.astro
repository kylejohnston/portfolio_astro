---
const path = Astro.url.pathname;

// Same relative-nav behavior as before: stay put on a curated /for/* page
// instead of always bouncing back to the root homepage.
const homeHref = path.startsWith('/for/') ? path : '/';

const isHomeActive = path === '/' || path.startsWith('/for/');
const isWorkActive = path.startsWith('/work');
const isAboutActive = path.startsWith('/about');
---

<nav class="site-nav" aria-label="Primary">
  <a
    href={homeHref}
    class="nav-pill nav-pill--home"
    class:list={[isHomeActive && 'is-active']}
    aria-current={isHomeActive ? 'page' : undefined}
  >
    <svg class="nav-pill__icon" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M224,120v96a8,8,0,0,1-8,8H160a8,8,0,0,1-8-8V164a4,4,0,0,0-4-4H108a4,4,0,0,0-4,4v52a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V120a16,16,0,0,1,4.69-11.31l80-80a16,16,0,0,1,22.62,0l80,80A16,16,0,0,1,224,120Z" />
    </svg>
    <span class="nav-pill__label">Home</span>
  </a>
  <a
    href="/work"
    class="nav-pill nav-pill--work"
    class:list={[isWorkActive && 'is-active']}
    aria-current={isWorkActive ? 'page' : undefined}
  >
    <svg class="nav-pill__icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M18.75 7.96875C18.75 13.4375 10.6414 17.8641 10.2961 18.0469C10.2051 18.0958 10.1033 18.1215 10 18.1215C9.89665 18.1215 9.79492 18.0958 9.70391 18.0469C9.35859 17.8641 1.25 13.4375 1.25 7.96875C1.25145 6.68455 1.76223 5.45337 2.6703 4.5453C3.57837 3.63723 4.80955 3.12645 6.09375 3.125C7.70703 3.125 9.11953 3.81875 10 4.99141C10.8805 3.81875 12.293 3.125 13.9062 3.125C15.1904 3.12645 16.4216 3.63723 17.3297 4.5453C18.2378 5.45337 18.7486 6.68455 18.75 7.96875Z" />
    </svg>
    <span class="nav-pill__label">Work</span>
  </a>
  <a
    href="/about"
    class="nav-pill nav-pill--about"
    class:list={[isAboutActive && 'is-active']}
    aria-current={isAboutActive ? 'page' : undefined}
  >
