---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { workGroups } from '../../data/workGroups';

const all = await getCollection('projects');

// A project id not listed in any group is silently omitted here — see the
// comment in workGroups.ts. A listed id with no matching project is almost
// certainly a typo, so that fails the build instead of disappearing quietly.
const groups = workGroups.map(({ label, ids }) => ({
  label,
  entries: ids.map((id) => {
    const entry = all.find((e) => e.id === id);
    if (!entry) throw new Error(`Unknown project id "${id}" in workGroups.ts`);
    return entry;
  }),
}));
---

<Layout title="All work">
  <h1 class="col-start-3 col-span-6 text-ink my-12">All work</h1>
  {groups.map(({ label, entries }) => (
      <h2 class="work-group-title col-start-3 col-span-6">{label}</h2>
      <div class="card-grid all-work mt-3 mb-15">
        {entries.map((entry) => <ProjectCard entry={entry} />)}
      </div>
  ))}
</Layout>

<style>
  .card-grid {
    grid-column: span 12;
    background: var(--color-paper);
    max-width: 1400px;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 24px;
    row-gap: 96px;
  }
  main h1,
  main :global(h1) {
    color: var(--color-paper);
    grid-column: 7 / 12;
    border: 1px solid blue !important;
  }
  .work-group-title {
    color: var(--color-ink);
  }
  /* :global() because .project-card is rendered by ProjectCard.astro, a
     separate component — a plain `.project-card` selector here compiles to
     require *this* page's scope attribute on the card itself, which it can
     never have. .all-work keeps the override specific to this page's grid
     rather than any card-grid anywhere. */
  .card-grid.all-work :global(.project-card) {
  }
</style>